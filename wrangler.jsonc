{
  "name": "folio-studio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-23",
  "account_id": "c57bb20727aa3564966d2bb693abddce",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "folio.wavey.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "build/cloudflare/app",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
